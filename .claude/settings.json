{
  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "permissions": {
    "allow": [
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(bunx tsc --noEmit)",
      "Bash(bunx tsc --noEmit *)",
      "Bash(bun run typecheck)",
      "Bash(bun scripts/typecheck-narrow.ts)",
      "Bash(bun scripts/typecheck-narrow.ts *)"
    ],
    "deny": [
      "Read(**/bot.env)",
      "Edit(**/bot.env)"
    ]
  }
}
