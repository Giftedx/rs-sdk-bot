+// Lockstep sim (SIM_LOCKSTEP=1 only): SIM_SEED=<int> makes the world's randomness repeatable. app.ts imports this
+// first, so Math.random is replaced before any module draws from it. The World reseeds Math.random and JavaRandom at
+// the start of every cycle from (seed, ticks since the anchor login): the rolls of tick N after the measured account
+// logged in are the same in every run with the same seed. SIM_SEED_ANCHOR (regex) names the login that starts the count.
+// Adapted from TestingPurposes/rs-stun-toolkit simseed.ts (MIT); never active on a wall-clock engine.
+const seedEnv = process.env.SIM_LOCKSTEP === '1' ? process.env.SIM_SEED : undefined;
+export const simSeed: number | null = seedEnv !== undefined && seedEnv !== '' ? (Number(seedEnv) >>> 0 || 1) : null;
+export const simSeedAnchor = new RegExp(process.env.SIM_SEED_ANCHOR ?? '.', 'i');
+let a = simSeed ?? 1;
+const mix = (x: number, y: number) => {
+    let h = Math.imul(x ^ 0x9e3779b9, 0x85ebca6b) ^ y;
+    h = Math.imul(h ^ (h >>> 13), 0xc2b2ae35);
+    return (h ^ (h >>> 16)) >>> 0;
+};
+/** Reseed Math.random for tick `n` since the anchor login; returns a 31-bit seed for JavaRandom. */
+export function simReseed(n: number): number {
+    a = mix(simSeed!, n) || 1;
+    return mix(simSeed! ^ 0x5bd1e995, n) & 0x7fffffff;
+}
+/** Math.random draws so far; the per-tick trace prints the difference. */
+export let simRandDraws = 0;
+if (simSeed !== null) {
+    // mulberry32
+    Math.random = () => {
+        simRandDraws++;
+        a = (a + 0x6d2b79f5) >>> 0;
+        let t = a;
+        t = Math.imul(t ^ (t >>> 15), t | 1);
+        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+    };
+    console.log(`[sim] SIM_SEED=${simSeed}: world randomness reseeded every tick (anchor ${simSeedAnchor})`);
+}
+
+// SIM_ACTION_FILE: one line for each message a client sends and one for each tick in which a player holds a
+// target, with the state that decides if the engine runs the action (delayed, modal, protect, reach). A bot sees
+// only that its action had no effect; this file shows what the engine did with it.
+import fs from 'fs';
+const actionFile = process.env.SIM_ACTION_FILE;
+let actionLines: string[] = [];
+export const simActionOn = !!actionFile;
+export function simAction(line: string): void {
+    actionLines.push(line);
+    if (actionLines.length >= 20) simActionFlush();
+}
+export function simActionFlush(): void {
+    if (actionFile && actionLines.length) { fs.appendFileSync(actionFile, actionLines.join('\n') + '\n'); actionLines = []; }
+}
