+import {expect,test} from 'bun:test';
+import {pumpSessionEnd} from './session.js';
+import ClientStream from '../io/ClientStream.js';
+import {ServerProt} from '../io/ServerProt.js';
+
+test('drains a logout packet buffered before the socket close',async()=>{
+ const socket:any={};const stream=new ClientStream(socket);let loggedOut=false;
+ socket.onmessage({data:Uint8Array.of(ServerProt.LOGOUT).buffer});socket.onclose({});
+ const reason=await pumpSessionEnd({isLoggedOut:()=>loggedOut,isInGame:()=>!stream.isClosed,pumpPackets:async()=>{if(stream.available>0)loggedOut=(await stream.read())===ServerProt.LOGOUT;}});
+ expect(reason).toBe('logged-out');expect(stream.available).toBe(0);
+});
+test('an abrupt socket close without logout stays disconnected',async()=>{
+ expect(await pumpSessionEnd({isLoggedOut:()=>false,isInGame:()=>false,pumpPackets:async()=>{}})).toBe('disconnected');
+});
+test('an open session stays active after draining',async()=>{
+ expect(await pumpSessionEnd({isLoggedOut:()=>false,isInGame:()=>true,pumpPackets:async()=>{}})).toBeNull();
+});
+test('an already observed logout does not read the closed stream again',async()=>{
+ expect(await pumpSessionEnd({isLoggedOut:()=>true,isInGame:()=>false,pumpPackets:async()=>{throw Error('read after logout');}})).toBe('logged-out');
+});
+test('a packet stream error is not converted into successful logout',async()=>{
+ await expect(pumpSessionEnd({isLoggedOut:()=>false,isInGame:()=>true,pumpPackets:async()=>{throw Error('bad stream');}})).rejects.toThrow('bad stream');
+});
