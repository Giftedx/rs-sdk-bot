# Third-party clones. Re-create with scripts/clone-vendor.sh.
# rs-sdk is a tracked submodule (pinned by gitlink and rs-sdk.pin), so it is un-ignored.
/vendor/*
!/vendor/rs-sdk
# YouTube auto-captions: private study copy, do not publish (research/video/talk-notes.md keeps only our notes)
/research/video/transcript.md
/research/video/*.vtt
/research/video/*.srt
node_modules/
.env
bot.env
.claude/settings.local.json
/.superpowers/
.practice/
# Sealed credentials live only on the fleet-data branch (packages/core/src/fleet-vault.ts); never on master.
/fleet/vault/
# Run outputs (generated by scripts; not source)
*.log
swarm.generated.json
swarm.validate.json

# Local tool output and downloads
.playwright-cli/
bun-linux-x64/
/data/
