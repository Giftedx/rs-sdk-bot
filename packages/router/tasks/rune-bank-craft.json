{
  "id": "rune-bank-craft",
  "goal": "Craft air runes from rune essence already in the bank: withdraw essence at the nearest bank, walk to the air altar, craft, bank the runes, repeat to a target level or until essence runs out.",
  "entry": "scripts/rune-bank-craft.ts",
  "files": [
    "scripts/rune-bank-craft.ts",
    "scripts/rune-bank-craft.test.ts",
    "packages/practice/src/rune-bank-craft-proof.ts"
  ],
  "consumer": "Runecraft XP and banked air runes rise by the essence spent; the essence count drops by the same amount; logout confirmed.",
  "checks": [
    {
      "id": "rune-bank-craft-regressions",
      "phase": "regression",
      "command": [
        "bun",
        "test",
        "scripts/rune-bank-craft.test.ts",
        "--timeout",
        "10000"
      ],
      "timeoutMs": 60000
    },
    {
      "id": "rune-bank-craft-practice",
      "phase": "practice",
      "command": [
        "bun",
        "packages/practice/src/rune-bank-craft-proof.ts"
      ],
      "timeoutMs": 900000
    },
    {
      "id": "rune-bank-craft-saved",
      "phase": "consumer",
      "command": [
        "bun",
        "packages/practice/src/rune-bank-craft-proof.ts",
        "--verify"
      ],
      "timeoutMs": 30000
    }
  ]
}